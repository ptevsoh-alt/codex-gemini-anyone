{
  "name": "codex-gemini-anyone",
  "version": "0.1.0",
  "private": false,
  "description": "Portable, configuration-driven task routing and human handoff runtime for Gemini and Flow web workflows.",
  "type": "commonjs",
  "engines": { "node": ">=18" },
  "bin": { "codex-gemini-anyone": "./bin/codex-gemini.js" },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "security:scan": "node scripts/security-scan.js",
    "skills:list": "node bin/codex-gemini.js skills list",
    "route": "node bin/codex-gemini.js route",
    "handoff": "node bin/codex-gemini.js handoff",
    "start": "node bin/codex-gemini.js start"
  }
}

